# Configuration for map_bacteria_with_decoys.sh
# Copy this file for each project/run and edit the paths below.

# Directory containing input FASTQ files. Files matching FASTQ_GLOB are processed.
FASTQ_DIR="."
FASTQ_GLOB="*.fastq*"

# Directory where pipeline outputs are written. Use "." to write beside the FASTQ files.
OUTPUT_DIR="."

# Set to true to run only a random subset of up to SAMPLE_SIZE reads per FASTQ.
# Use the same seed to reproduce a sample, or change it to draw another subset.
SAMPLE_READS="false"
SAMPLE_SIZE="5000"
SAMPLE_SEED="1"

# Reference basename for the decoy/pangenome. A .mmi index is reused or built
# from a .fa/.fasta/.fna file sharing this basename.
# Example: /path/to/referencegenomes/Gina_Pangenome
DECOY_MINIMAP2_REFERENCE="/path/to/referencegenomes/Gina_Pangenome"

# Reference basename for the target bacterium. The pipeline uses/builds the
# minimap2 .mmi index from FASTA and finds a GFF/GFF3 sharing this basename.
# Example files: bacteria_reference.fasta and bacteria_reference.gff3
BACTERIA_MINIMAP2_REFERENCE="/path/to/referencegenomes/bacteria_reference"

# Optional reference basename for the host. Leave empty to skip host mapping
# and counting. The index (or FASTA) and GFF annotation must share this basename.
HOST_MINIMAP2_REFERENCE=""

# Long-read minimap2 mapping preset. Use map-ont for Oxford Nanopore reads,
# map-hifi for PacBio HiFi reads, or map-pb for older PacBio CLR reads.
MINIMAP2_PRESET="map-ont"

# legacy keeps the original Nanopore/optional Illumina adapter choices.
# neb_e7330 extracts NEBNext E7330S small RNA inserts in either ONT orientation.
ADAPTER_TRIMMING_MODE="legacy"
CUTADAPT_ERROR_RATE="0.15"
CUTADAPT_MIN_OVERLAP="12"
ADAPTER_MAX_TRIMMING_ROUNDS="10"

# NEB mode removes both outer flanks before terminal-only repeat cleanup.
ADAPTER_NEB_5P="GTTCAGAGTTCTACAGTCCGACGATC"
ADAPTER_NEB_3P="AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC"
# Cutadapt --revcomp handles the corresponding reverse complements:
# 5P_RC: GATCGTCGGACTGTAGAACTCTGAAC
# 3P_RC: GTGACTGGAGTTCAGACGTGTGCTCTTCCGATCT

# Complete NEB flanks already remove outer Nanopore sequences. In NEB mode,
# this enables terminal-only Nanopore cleanup for incompletely bounded reads.
TRIM_NANOPORE_ADAPTERS="true"
ADAPTER_NANOPORE="TTTCTGTTGGTGCTGATATTGC"
ADAPTER_NANOPORE_RC="GCAATATCAGCACCAACAGAAA"
# When changing ADAPTER_NANOPORE, update its RC too, or leave the RC empty
# to compute it automatically. Nanopore matches never orient NEB inserts.

# TruSeq is a different kit and is excluded from NEB matching by default.
TRIM_TRUSEQ_SMALL_RNA="false"
ADAPTER_TRUSEQ_SMALL_RNA="TGGAATTCTCGGGTGCCAAGG"

# In legacy mode, optionally run a second Cutadapt adapter pass. This
# removes standard Illumina and Illumina small-RNA kit 3' adapters while
# retaining reads in which neither adapter is found.
TRIM_ILLUMINA_ADAPTERS="false"
ADAPTER_ILLUMINA="AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
ADAPTER_ILLUMINA_SMALL_RNA="TGGAATTCTCGGGTGCCAAGG"
# Apply length filtering once, after all adapter trimming. Existing project
# configs retain their explicit lengths (for example, 22 nt).
MIN_READ_LENGTH="20"

# Number of threads used by every multithreaded pipeline step.
THREADS="16"

# Normalized bacterial feature-position profiles use this many 5'-to-3' bins.
# Features with fewer assigned reads remain in detailed outputs but do not
# contribute to aggregate metagene profiles.
GENE_POSITION_BINS="100"
METAGENE_MIN_FEATURE_READS="10"

# Path to the summary conversion script. Relative paths are resolved from this repository.
CSV_CONVERSION_SCRIPT="bacteria_with_decoys_csvConversion.py"
