# Configuration for map_bacteria_with_decoys.sh
# Copy this file for each project/run and edit the paths below.

# Directory containing input FASTQ files. Files matching FASTQ_GLOB are processed.
FASTQ_DIR="."
FASTQ_GLOB="*.fastq*"

# Array submission limits. Every discovered sample is processed; exceeding
# this limit is an error. Increase it explicitly to submit a larger run.
SLURM_MAX_SAMPLES="40"
SLURM_MAX_CONCURRENT="8"
# PACE allocation/account used for every submitted job. Fill this in.
SLURM_ACCOUNT=""
# Your full notification email address, for example your PACE username's email.
# Leave empty to disable job emails. These settings apply to every job stage.
SLURM_MAIL_USER=""
SLURM_MAIL_TYPE="END,FAIL"

# Conda initialization script and environment used on compute nodes.
# Fill in your installation path; the environment can be a name or full path.
CONDA_SH="/path/to/YOUR_USERNAME/miniforge3/etc/profile.d/conda.sh"
CONDA_ENV="longread-bacteria-RNAseq-pipeline"
# Set true only when your site's job setup already activates the environment.
PIPELINE_SKIP_CONDA="false"

# Directory where pipeline outputs are written. Use "." to write beside the FASTQ files.
OUTPUT_DIR="."

# Set to true to run only a random subset of up to SAMPLE_SIZE reads per FASTQ.
# Use the same seed to reproduce a sample, or change it to draw another subset.
SAMPLE_READS="false"
SAMPLE_SIZE="5000"
SAMPLE_SEED="1"

# Reference folders are searched recursively for plain or gzipped FASTA and
# GBFF/GFF annotations. Existing Bowtie2/minimap2 index files are ignored.
DECOY_REFERENCE_DIR="/path/to/referencegenomes/decoy"
BACTERIA_REFERENCE_DIR="/path/to/referencegenomes/PAO1"

# Optional host folder: human or mouse, including its *_DNA and *_RNA folders
# and every RNA shard. Leave empty to skip host alignment and counting.
HOST_REFERENCE_DIR=""

# After decoy filtering, only unmapped reads advance through:
# bacterial RNA -> host RNA (optional) -> bacterial DNA -> host DNA (optional).
# Bacterial cds_from_genomic FASTA files join the RNA references.

# BBSplit k-mer length: integer from 1 through 15, default 11.
# All stages use mapmode=pb msa=MultiStateAligner9PacBio fastareadlen=6000,
# qtrim=f (no extra quality trimming), and interleaved=f (single reads).
# After all adapter trimming, reads over 6000 bp are saved separately and
# excluded from alignment; reads exactly 6000 bp remain eligible.
BBSPLIT_K="11"

# Space- or newline-separated adapter sequences for any Nanopore library.
# Each adapter is searched only at the two read ends with Cutadapt.
# Add every library adapter that should be removed; an empty list skips matching.
ADAPTER_SEQUENCES="TTTCTGTTGGTGCTGATATTGC"
# Example with several adapters (replace these with your library's sequences):
# ADAPTER_SEQUENCES="TTTCTGTTGGTGCTGATATTGC GTTCAGAGTTCTACAGTCCGACGATC AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC"

# Also recognize reverse complements of the adapter sequences. Read orientation
# stays unchanged. Each round removes at most one adapter from each read end.
ADAPTER_REVERSE_COMPLEMENTS="true"
ADAPTER_MAX_TRIMMING_ROUNDS="3"
CUTADAPT_ERROR_RATE="0.15"
CUTADAPT_MIN_OVERLAP="12"

# Apply length filtering after all adapter trimming. Valid range: 1..6000.
# Reads shorter than this value are discarded; reads over 6000 bp are saved
# separately under bbsplit_alignments/oversized_reads and counted in the CSVs.
# Existing project configs retain explicit minimums (for example, 22 nt).
MIN_READ_LENGTH="20"

# Number of threads used by every multithreaded pipeline step.
THREADS="16"

# Normalized bacterial feature-position profiles use this many 5'-to-3' bins.
# Features with fewer assigned reads remain in detailed outputs but do not
# contribute to aggregate metagene profiles.
GENE_POSITION_BINS="100"
METAGENE_MIN_FEATURE_READS="10"

# Path to the summary conversion script. Relative paths are resolved from this repository.
CSV_CONVERSION_SCRIPT="bacteria_with_decoys_csvConversion.py"
